{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CmdPolish",
  "version": "0.3.1",
  "identifier": "com.cmdpolish.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CmdPolish",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sooua/cmdpolish/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNUY1NkVGRTA5NzUwOUIKUldTYlVKZmc3MVpmVWNnRGpvN0wzQ2tnYlpNZkR4M2U0aFJIWTBJZHAwN25qVUJrc3pkZkFPVnQK"
    }
  }
}
